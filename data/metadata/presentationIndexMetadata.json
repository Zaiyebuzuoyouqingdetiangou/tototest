      ],
      "aliases": [
        "视觉小说",
        "Visual Novel"
      ],
      "summaryOverride": "内存 / 读取档案接口、剧情选项分支图、CG回忆模式、角色好感度/属性面板、ADV等；必须实际呈现 ADV 对话框、人物舞台、选项分支、存读档、好感变化或 CG 回想中的至少一项，不得只是普通文本卡。",
      "aliasesBeforeSummary": true
    },
